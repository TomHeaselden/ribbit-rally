{
  "name": "ribbit-rally",
  "productName": "Ribbit Rally",
  "version": "0.0.1",
  "description": "A frog jetski racing game: 81 pond courses, 8 frogs, power-ups, koi carp and plenty of ribbits.",
  "main": "./out/main/index.js",
  "private": true,
  "author": "TomHeaselden",
  "homepage": "https://github.com/TomHeaselden/ribbit-rally",
  "repository": {
    "type": "git",
    "url": "https://github.com/TomHeaselden/ribbit-rally.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.ribbitrally.game",
    "productName": "Ribbit Rally",
    "copyright": "Ribbit Rally",
    "artifactName": "Ribbit-Rally-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "afterPack": "build/after-pack.js",
    "mac": {
      "category": "public.app-category.racing-games",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Ribbit Rally"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ribbit Rally",
      "artifactName": "Ribbit-Rally-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "Ribbit-Rally-${version}-windows-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "maintainer": "TomHeaselden <37985112+TomHeaselden@users.noreply.github.com>",
      "synopsis": "Frog jetski racing game",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
